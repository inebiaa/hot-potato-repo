# Copy to .env and fill in (never commit .env)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: canonical site URL for JSON-LD / sitemap
# VITE_PUBLIC_SITE_URL=https://www.secretblogger.app

# Cloudflare R2 image CDN (custom domain, not *.r2.dev)
# Dashboard:
# 1. R2 > Create bucket (e.g. secret-blogger-images), Standard storage
# 2. Settings > Custom Domains > connect images.secretblogger.app
#    (zone must be in the same Cloudflare account; do not use the r2.dev URL)
# 3. Manage R2 API Tokens > Create token (Object Read & Write on that bucket)
# 4. Caching > Cache Rules for images.secretblogger.app: eligible for cache,
#    Edge TTL eligible, respect origin Cache-Control (jpgs cache by default)
# 5. supabase secrets set the R2_* vars below, then deploy functions
VITE_IMAGE_CDN_URL=https://images.secretblogger.app
R2_PUBLIC_BASE_URL=https://images.secretblogger.app
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=secret-blogger-images
