{
  "name": "hot-potato-repo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test src/lib/feedImageAttrs.test.ts src/lib/eventCardBodyClick.test.ts src/lib/eventCardImageUrl.test.ts src/lib/imageCdn.test.ts src/lib/eventsFeed.test.ts src/lib/eventTagFilter.test.ts src/lib/searchParamsModal.test.ts src/lib/homeCatalogRoute.test.ts src/lib/appModalState.test.ts",
    "verify:jsonld": "node scripts/verify-event-jsonld.mjs",
    "migrate:images-to-r2": "node scripts/migrate-images-to-r2.mjs",
    "backfill:event-images": "node scripts/backfill-event-images.mjs",
    "recompress:event-images": "node scripts/recompress-event-images-local.mjs",
    "recompress:event-images:remote": "node scripts/invoke-recompress-event-images.mjs",
    "cleanup:orphan-event-images": "node scripts/cleanup-orphan-event-images.mjs",
    "backfill:branding-images": "node scripts/backfill-branding-images.mjs",
    "generate:pwa-icons": "node scripts/create-pwa-icons.mjs",
    "dev": "vite"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "imagescript": "^1.3.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
